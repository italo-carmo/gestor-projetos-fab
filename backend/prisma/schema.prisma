// Prisma schema for CIPAVD Gestao

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  ldapUid             String?   @unique
  name                String
  passwordHash        String
  isActive            Boolean   @default(true)
  executiveHidePii    Boolean   @default(false)
  loginFailedCount    Int       @default(0)
  lockUntil           DateTime?
  omId                String?
  localityId          String?
  specialtyId         String?
  eloRoleId           String? // Responsável por este elo (ex: Psicologia a nível Brasil)
  commissionFunction  String?
  commissionPhone     String?
  commissionSeniority Int?
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpBackupCodes     String[]  @default([])
  flagsJson           Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  om                                      Om?                              @relation(fields: [omId], references: [id], onDelete: SetNull)
  locality                                Locality?                        @relation(fields: [localityId], references: [id])
  specialty                               Specialty?                       @relation(fields: [specialtyId], references: [id])
  eloRole                                 EloRole?                         @relation(fields: [eloRoleId], references: [id])
  roles                                   UserRole[]
  moduleAccessOverrides                   UserModuleAccessOverride[]
  menuUpdateReads                         UserMenuUpdateRead[]
  refreshTokens                           RefreshToken[]
  assignedTasks                           TaskInstance[]                   @relation("TaskAssignee")
  taskResponsibilities                    TaskResponsible[]                @relation("TaskResponsibleUser")
  taskResponsibilityAssignments           TaskResponsible[]                @relation("TaskResponsibleAssigner")
  taskComments                            TaskComment[]                    @relation("TaskCommentAuthor")
  taskCommentReads                        TaskCommentRead[]
  createdActivities                       Activity[]                       @relation("ActivityCreator")
  createdMissions                         Mission[]                        @relation("MissionCreator")
  createdSocialCommunicationArticles      SocialCommunicationArticle[]     @relation("SocialCommunicationArticleCreator")
  createdSocialCommunicationHighlights    SocialCommunicationHighlight[]   @relation("SocialCommunicationHighlightCreator")
  missionParticipations                   MissionParticipant[]
  activityResponsibilities                ActivityResponsible[]            @relation("ActivityResponsibleUser")
  activityResponsibilityAssignments       ActivityResponsible[]            @relation("ActivityResponsibleAssigner")
  activityComments                        ActivityComment[]                @relation("ActivityCommentAuthor")
  activityCommentReads                    ActivityCommentRead[]
  signedActivityReports                   ActivityReport[]                 @relation("ActivityReportSigner")
  auditLogs                               AuditLog[]
  meetingParticipations                   MeetingParticipant[]
  biSurveyImportBatches                   BiSurveyImportBatch[]
  biSurveyCardSettings                    BiSurveyCardSetting[]            @relation("BiSurveyCardSettingUpdatedBy")
  biDomesticViolenceImportBatches         BiDomesticViolenceImportBatch[]
  biDomesticViolenceCardSettings          BiDomesticViolenceCardSetting[]  @relation("BiDomesticViolenceCardSettingUpdatedBy")
  biRecruitsImportBatches                 BiRecruitsImportBatch[]
  biRecruitsCardSettings                  BiRecruitsCardSetting[]          @relation("BiRecruitsCardSettingUpdatedBy")
  biBestPracticeCycleImportBatches        BiBestPracticeCycleImportBatch[]
  biBestPracticeCycleCardSettings         BiBestPracticeCycleCardSetting[] @relation("BiBestPracticeCycleCardSettingUpdatedBy")
  biCpcaMeetingImportBatches              BiCpcaMeetingImportBatch[]
  biCpcaMeetingCardSettings               BiCpcaMeetingCardSetting[]       @relation("BiCpcaMeetingCardSettingUpdatedBy")
  biGsdEvaluationImportBatches            BiGsdEvaluationImportBatch[]
  biGsdEvaluationCardSettings             BiGsdEvaluationCardSetting[]     @relation("BiGsdEvaluationCardSettingUpdatedBy")
  cpcaCasesCreated                        CpcComplaintCase[]               @relation("CpcComplaintCaseCreatedBy")
  cpcaCasesUpdated                        CpcComplaintCase[]               @relation("CpcComplaintCaseUpdatedBy")
  cpcaCaseComments                        CpcComplaintComment[]            @relation("CpcComplaintCommentAuthor")
  cpcaCaseCipavdThreadsCreated            CpcComplaintCipavdThread[]       @relation("CpcComplaintCipavdThreadCreatedBy")
  cpcaCaseCipavdThreadsResolved           CpcComplaintCipavdThread[]       @relation("CpcComplaintCipavdThreadResolvedBy")
  cpcaCaseCipavdThreadsClosed             CpcComplaintCipavdThread[]       @relation("CpcComplaintCipavdThreadClosedBy")
  cpcaCaseCipavdMessages                  CpcComplaintCipavdMessage[]      @relation("CpcComplaintCipavdMessageAuthor")
  cpcaCaseStatusChanges                   CpcComplaintStatusHistory[]      @relation("CpcComplaintStatusChangedBy")
  cpcaCommissionPresidentAssignments      CpcaCommissionPresident[]        @relation("CpcaCommissionPresidentUser")
  cpcaCommissionPresidentAssignmentsMade  CpcaCommissionPresident[]        @relation("CpcaCommissionPresidentAssignedBy")
  cpcaCommissionMemberships               CpcaCommissionMember[]           @relation("CpcaCommissionMemberUser")
  cpcaCommissionMembershipsAdded          CpcaCommissionMember[]           @relation("CpcaCommissionMemberAddedBy")
  cpcaChecklistUpdates                    CpcaChecklistItem[]              @relation("CpcaChecklistUpdatedBy")
  cpcaChecklistHistoryEntriesCreated      CpcaChecklistHistoryEntry[]      @relation("CpcaChecklistHistoryCreatedBy")
  cpcaPresidentRequests                   CpcaPresidentSelfRegistration[]  @relation("CpcaPresidentSelfRegistrationApplicant")
  cpcaPresidentRequestDecisions           CpcaPresidentSelfRegistration[]  @relation("CpcaPresidentSelfRegistrationDecidedBy")
  cpcaPresidentNominationRequestsCreated  CpcaPresidentNominationRequest[] @relation("CpcaPresidentNominationRequester")
  cpcaPresidentNominationRequestsNominee  CpcaPresidentNominationRequest[] @relation("CpcaPresidentNominationNominee")
  cpcaPresidentNominationRequestDecisions CpcaPresidentNominationRequest[] @relation("CpcaPresidentNominationDecider")
  cpcaCoverageRequestsCreated             CpcaCommissionCoverageRequest[]  @relation("CpcaCoverageRequestRequester")
  cpcaCoverageRequestDecisions            CpcaCommissionCoverageRequest[]  @relation("CpcaCoverageRequestDecider")
  strategicRecommendationsCreated         StrategicRecommendation[]        @relation("StrategicRecommendationCreator")
  libraryPhotosCreated                    LibraryPhoto[]                   @relation("LibraryPhotoCreator")
  libraryDocumentsCreated                 LibraryDocument[]                @relation("LibraryDocumentCreator")
  bestPracticesCreated                    BestPracticePost[]               @relation("BestPracticeCreator")
  lessonsLearnedCreated                   LessonLearnedPost[]              @relation("LessonLearnedCreator")
  smifComplaintsCreated                   SmifComplaint[]                  @relation("SmifComplaintCreatedBy")
  smifComplaintsUpdated                   SmifComplaint[]                  @relation("SmifComplaintUpdatedBy")
}

model Om {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  uf        String?
  hasCpca   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                           User[]
  cpcaCases                       CpcComplaintCase[]
  cpcaCommissionPresident         CpcaCommissionPresident?
  cpcaCommissionMembers           CpcaCommissionMember[]
  cpcaChecklistItems              CpcaChecklistItem[]
  cpcaChecklistHistoryEntries     CpcaChecklistHistoryEntry[]
  cpcaPresidentRequests           CpcaPresidentSelfRegistration[]
  cpcaPresidentNominationRequests CpcaPresidentNominationRequest[]
  cpcaCoverageRequests            CpcaCommissionCoverageRequest[]
  cpcaCoverageAsManager           CpcaCommissionCoverageOm[]       @relation("CpcaCoverageOmManager")
  cpcaCoverageAsManaged           CpcaCommissionCoverageOm[]       @relation("CpcaCoverageOmManaged")
  biNormalizationLinks            BiNormalizationLink[]
  strategicRecommendations        StrategicRecommendation[]

  @@index([hasCpca])
  @@index([uf])
}

model UserModuleAccessOverride {
  id        String   @id @default(cuid())
  userId    String
  resource  String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@index([userId])
  @@index([resource])
}

model Role {
  id                      String   @id @default(cuid())
  name                    String   @unique
  description             String?
  isSystemRole            Boolean  @default(false)
  wildcard                Boolean  @default(false)
  flagsJson               Json?
  constraintsTemplateJson Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String          @id @default(cuid())
  resource    String
  action      String
  scope       PermissionScope
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roles RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Locality {
  id                         String              @id @default(cuid())
  code                       String
  name                       String
  uf                         String? // Sigla do estado (ex: SP, RJ, DF)
  hasCpca                    Boolean             @default(false)
  catalogType                LocalityCatalogType @default(SMIF)
  commandName                String?
  commanderName              String?
  individualMeetingDate      DateTime? // Data da Reunião Individual
  visitDate                  DateTime? // Data da Visita da CIPAV
  recruitsFemaleCountCurrent Int?
  notes                      String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  users                         User[]
  taskInstances                 TaskInstance[]
  activities                    Activity[]
  missions                      Mission[]
  meetings                      Meeting[]
  recruitsHistory               RecruitsHistory[]
  notices                       Notice[]
  elos                          Elo[]
  documents                     DocumentAsset[]
  checklistItemStatuses         ChecklistItemStatus[]
  kpiValues                     KpiValue[]
  auditLogs                     AuditLog[]
  cpcaCases                     CpcComplaintCase[]
  recruitDesignationsFrom       RecruitOmAssignment[]          @relation("RecruitOmAssignmentSource")
  recruitDesignationsTo         RecruitOmAssignment[]          @relation("RecruitOmAssignmentDestination")
  recruitMembers                RecruitFemale[]                @relation("RecruitSourceLocality")
  recruitsDesignatedHere        RecruitFemale[]                @relation("RecruitDestinationLocality")
  libraryPhotos                 LibraryPhoto[]
  bestPracticePosts             BestPracticePost[]
  socialCommunicationHighlights SocialCommunicationHighlight[]
  smifComplaints                SmifComplaint[]
  cpcaCoverageAsManager         CpcaCommissionCoverage[]       @relation("CpcaCoverageManager")
  cpcaCoverageAsManaged         CpcaCommissionCoverage[]       @relation("CpcaCoverageManaged")

  @@unique([code, catalogType])
  @@index([catalogType])
}

model CpcaCommissionCoverage {
  id                String   @id @default(cuid())
  managerLocalityId String
  managedLocalityId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  managerLocality Locality @relation("CpcaCoverageManager", fields: [managerLocalityId], references: [id], onDelete: Cascade)
  managedLocality Locality @relation("CpcaCoverageManaged", fields: [managedLocalityId], references: [id], onDelete: Cascade)

  @@unique([managerLocalityId, managedLocalityId])
  @@index([managerLocalityId])
  @@index([managedLocalityId])
}

model CpcaCommissionCoverageOm {
  id          String   @id @default(cuid())
  managerOmId String
  managedOmId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managerOm Om @relation("CpcaCoverageOmManager", fields: [managerOmId], references: [id], onDelete: Cascade)
  managedOm Om @relation("CpcaCoverageOmManaged", fields: [managedOmId], references: [id], onDelete: Cascade)

  @@unique([managerOmId, managedOmId])
  @@index([managerOmId])
  @@index([managedOmId])
}

model Activity {
  id             String         @id @default(cuid())
  title          String
  description    String?
  localityId     String?
  activityTypeId String?
  specialtyId    String?
  eventDate      DateTime?
  status         ActivityStatus @default(NOT_STARTED)
  scope          ActivityScope  @default(SMIF)
  reportRequired Boolean        @default(false)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  locality             Locality?                   @relation(fields: [localityId], references: [id])
  activityType         ActivityType?               @relation(fields: [activityTypeId], references: [id])
  specialty            Specialty?                  @relation(fields: [specialtyId], references: [id])
  specialties          ActivitySpecialty[]
  createdBy            User?                       @relation("ActivityCreator", fields: [createdById], references: [id])
  report               ActivityReport?
  documents            DocumentAsset[]
  visitScheduleItems   ActivityVisitScheduleItem[]
  responsibles         ActivityResponsible[]
  missionScheduleItems MissionScheduleItem[]
  comments             ActivityComment[]
  commentReads         ActivityCommentRead[]

  @@index([localityId])
  @@index([activityTypeId])
  @@index([specialtyId])
  @@index([status])
  @@index([eventDate])
  @@index([scope])
}

model ActivitySpecialty {
  activityId  String
  specialtyId String
  createdAt   DateTime @default(now())

  activity  Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([activityId, specialtyId])
  @@index([specialtyId])
}

model ActivityType {
  id        String        @id @default(cuid())
  name      String
  scope     ActivityScope @default(SMIF)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  activities Activity[]

  @@unique([scope, name])
  @@index([scope])
}

model Mission {
  id            String        @id @default(cuid())
  title         String
  description   String?
  checklistJson Json?
  localityId    String
  scope         ActivityScope @default(SMIF)
  startDate     DateTime
  endDate       DateTime
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  locality      Locality              @relation(fields: [localityId], references: [id])
  createdBy     User?                 @relation("MissionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants  MissionParticipant[]
  scheduleItems MissionScheduleItem[]
  banners       MissionBanner[]

  @@index([localityId, startDate])
  @@index([startDate, endDate])
  @@index([scope, localityId])
}

model MissionParticipant {
  id        String   @id @default(cuid())
  missionId String
  userId    String?
  ldapUid   String?
  cpf       String?
  email     String?
  name      String
  fabom     String?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([missionId, createdAt])
  @@index([userId])
}

model MissionScheduleItem {
  id              String   @id @default(cuid())
  missionId       String
  activityId      String?
  title           String
  startAt         DateTime
  durationMinutes Int
  location        String
  responsible     String
  participants    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mission  Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([missionId, startAt])
  @@index([activityId])
}

model MissionBanner {
  id                String   @id @default(cuid())
  missionId         String
  name              String
  eventDate         String
  eventTime         String
  locationPrimary   String
  locationSecondary String?
  layoutOverrides   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, eventDate, eventTime])
}

model MissionChecklistDimension {
  id        String   @id @default(cuid())
  sectionId String
  title     String
  prompt    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, isActive, sortOrder, createdAt])
}

model MissionChecklistClassificationSetting {
  id        String   @id
  label     String
  colorHex  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, createdAt])
}

model DashboardNationalCardSetting {
  id              String   @id
  title           String
  description     String
  backgroundColor String
  textColor       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityVisitScheduleItem {
  id              String   @id @default(cuid())
  activityId      String
  title           String
  startTime       String
  durationMinutes Int
  location        String
  responsible     String
  participants    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, startTime])
}

model ActivityReport {
  id                          String    @id @default(cuid())
  activityId                  String    @unique
  date                        DateTime
  location                    String
  responsible                 String
  missionSupport              String
  introduction                String
  missionObjectives           String
  executionSchedule           String
  activitiesPerformed         String
  participantsCount           Int
  participantsMaleCount       Int?
  participantsFemaleCount     Int?
  publicProfile               String?
  instructorsCount            Int       @default(0)
  recruitsCount               Int       @default(0)
  eloPsychologyCount          Int       @default(0)
  eloSocialAssistanceCount    Int       @default(0)
  eloJuridicoCount            Int       @default(0)
  eloCpcaCount                Int       @default(0)
  eloGraduadoMasterCount      Int       @default(0)
  participantsCharacteristics String
  mainPointsObserved          String?
  attentionPoints             String?
  nextSteps                   String?
  referencesAndAttachments    String?
  conclusion                  String
  city                        String
  closingDate                 DateTime
  signaturePayloadHash        String?
  signatureHash               String?
  signatureAlgorithm          String?
  signatureVersion            Int?
  signedAt                    DateTime?
  signedById                  String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  activity Activity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  signedBy User?                 @relation("ActivityReportSigner", fields: [signedById], references: [id], onDelete: SetNull)
  photos   ActivityReportPhoto[]
}

model ActivityReportPhoto {
  id         String   @id @default(cuid())
  reportId   String
  fileName   String
  fileUrl    String
  storageKey String?
  mimeType   String?
  fileSize   Int?
  checksum   String?
  createdAt  DateTime @default(now())

  report ActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  activities    Activity[]
  activityLinks ActivitySpecialty[]
  templates     TaskTemplate[]
  taskInstances TaskInstance[]
  notices       Notice[]
  checklists    Checklist[]
  kpiValues     KpiValue[]
}

model Phase {
  id          String    @id @default(cuid())
  name        PhaseName @unique
  displayName String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  templates  TaskTemplate[]
  checklists Checklist[]
}

model TaskTemplate {
  id                     String    @id @default(cuid())
  title                  String
  description            String?
  phaseId                String
  specialtyId            String?
  eloRoleId              String?
  appliesToAllLocalities Boolean
  reportRequiredDefault  Boolean
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  phase          Phase           @relation(fields: [phaseId], references: [id])
  specialty      Specialty?      @relation(fields: [specialtyId], references: [id])
  eloRole        EloRole?        @relation(fields: [eloRoleId], references: [id])
  instances      TaskInstance[]
  checklistItems ChecklistItem[]

  @@index([phaseId])
  @@index([deletedAt])
}

model TaskInstance {
  id                   String            @id @default(cuid())
  taskTemplateId       String
  localityId           String
  scope                ActivityScope     @default(SMIF)
  groupKey             String?
  titleOverride        String?
  specialtyId          String?
  meetingId            String?
  eloRoleId            String?
  dueDate              DateTime
  status               TaskStatus
  priority             TaskPriority
  progressPercent      Int
  assignedToId         String?
  assignedEloId        String?
  assigneeType         TaskAssigneeType?
  externalAssigneeName String?
  externalAssigneeRole String?
  reportRequired       Boolean
  blockedByIdsJson     Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  taskTemplate TaskTemplate      @relation(fields: [taskTemplateId], references: [id])
  locality     Locality          @relation(fields: [localityId], references: [id])
  specialty    Specialty?        @relation(fields: [specialtyId], references: [id])
  meeting      Meeting?          @relation(fields: [meetingId], references: [id])
  eloRole      EloRole?          @relation(fields: [eloRoleId], references: [id])
  assignedTo   User?             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedElo  Elo?              @relation("TaskAssigneeElo", fields: [assignedEloId], references: [id])
  reports      Report[]
  responsibles TaskResponsible[]
  comments     TaskComment[]
  commentReads TaskCommentRead[]

  @@index([localityId])
  @@index([scope])
  @@index([specialtyId])
  @@index([scope, localityId, dueDate, status])
  @@index([localityId, dueDate, status])
  @@index([meetingId])
  @@index([eloRoleId])
  @@index([assignedEloId])
  @@index([groupKey])
}

model TaskResponsible {
  id             String   @id @default(cuid())
  taskInstanceId String
  userId         String
  assignedById   String?
  createdAt      DateTime @default(now())

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  user         User         @relation("TaskResponsibleUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("TaskResponsibleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskInstanceId, userId])
  @@index([taskInstanceId, createdAt])
  @@index([userId])
}

model ActivityResponsible {
  id           String   @id @default(cuid())
  activityId   String
  userId       String
  assignedById String?
  createdAt    DateTime @default(now())

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation("ActivityResponsibleUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("ActivityResponsibleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([activityId, userId])
  @@index([activityId, createdAt])
  @@index([userId])
}

model Posto {
  id        String   @id @default(cuid())
  code      String   @unique // ex: SGT, CAP, SOLD
  name      String // ex: Sargento, Capitão, Soldado
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id               String        @id @default(cuid())
  datetime         DateTime
  scope            String        @default("") // texto livre: o que será tratado na reunião
  status           MeetingStatus
  meetingType      MeetingType   @default(PRESENCIAL)
  location         String?
  meetingLink      String?
  agenda           String?
  localityId       String?
  participantsJson Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  locality     Locality?            @relation(fields: [localityId], references: [id])
  participants MeetingParticipant[]
  tasks        TaskInstance[]
  decisions    MeetingDecision[]
  documents    DocumentAsset[]
}

model MeetingParticipant {
  id        String @id @default(cuid())
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model MeetingDecision {
  id        String   @id @default(cuid())
  meetingId String
  text      String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Report {
  id             String   @id @default(cuid())
  taskInstanceId String
  fileName       String
  fileUrl        String
  storageKey     String?
  mimeType       String?
  fileSize       Int?
  checksum       String?
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id])
}

model DocumentAsset {
  id            String           @id @default(cuid())
  title         String
  category      DocumentCategory
  subcategoryId String?
  sourcePath    String
  fileName      String
  fileUrl       String
  storageKey    String?
  mimeType      String?
  fileSize      Int?
  checksum      String?
  localityId    String?
  activityId    String?
  meetingId     String?
  tagsJson      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

