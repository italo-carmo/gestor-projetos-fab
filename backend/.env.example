DATABASE_URL="postgresql://smif:smif@localhost:5432/smif_gestao"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="24h"
JWT_REFRESH_TTL="30d"
PORT=3000
# LiteLLM (OpenAI-compatible): todas as chamadas de IA do backend usam estes valores
API_LITELLM=""
API_LITELLM_BASE_URL=""
# Opcional — modelo exposto no proxy LiteLLM (ex.: gpt-4o-mini ou alias configurado no servidor)
API_LITELLM_MODEL=""
LOG_LEVEL="info"
REPORTS_SIGNED_URL_SECRET="change-me-signed-url"
REPORTS_SIGNED_URL_TTL="600s"
REPORTS_ALLOW_EXEC_DOWNLOAD="false"
ACTIVITY_SIGNATURE_SECRET="change-me-activity-signature"
LDAP_FAB_URL="ldap://10.228.64.168:389"
LDAP_FAB_BASE_DN="ou=contas,dc=fab,dc=intraer"
# Opcional (caso o LDAP exija bind de serviço para buscas administrativas):
# LDAP_FAB_BIND_DN="uid=usuario-servico,ou=contas,dc=fab,dc=intraer"
# LDAP_FAB_BIND_PASSWORD="senha-servico"
