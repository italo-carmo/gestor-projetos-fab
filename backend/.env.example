DATABASE_URL="postgresql://smif:smif@localhost:5432/smif_gestao"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="24h"
JWT_REFRESH_TTL="30d"
PORT=3000
# LiteLLM (OpenAI-compatible): produção usa o mesmo arquivo que o systemd (EnvironmentFile), ex.:
#   /opt/gestao-projetos/backend/.env
# Chave (uma delas): API_LITELLM | LITELLM_API_KEY | OPENAI_API_KEY
API_LITELLM=""
# Base URL sem /v1 no final (ex.: http://172.16.31.84:4000). Alternativas: LITELLM_BASE_URL | OPENAI_BASE_URL
API_LITELLM_BASE_URL=""
# Modelo = id exato de GET /v1/models (ex.: gpt-oss:20b com dois pontos). Padrão no código já é esse id.
# Se no .env estiver gpt-oss-20b (hífen), o backend normaliza para gpt-oss:20b.
API_LITELLM_MODEL="gpt-oss:20b"
# Opcional — força openai/gpt-oss-20b (só se o proxy exigir esse formato):
# API_LITELLM_OPENAI_STYLE_MODEL=1
LOG_LEVEL="info"
REPORTS_SIGNED_URL_SECRET="change-me-signed-url"
REPORTS_SIGNED_URL_TTL="600s"
REPORTS_ALLOW_EXEC_DOWNLOAD="false"
ACTIVITY_SIGNATURE_SECRET="change-me-activity-signature"
LDAP_FAB_URL="ldap://10.228.64.168:389"
LDAP_FAB_BASE_DN="ou=contas,dc=fab,dc=intraer"
# Opcional (caso o LDAP exija bind de serviço para buscas administrativas):
# LDAP_FAB_BIND_DN="uid=usuario-servico,ou=contas,dc=fab,dc=intraer"
# LDAP_FAB_BIND_PASSWORD="senha-servico"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="CPCA COMGEP"
# Se vazio, o backend usa SMTP_USER como remetente.
SMTP_FROM_EMAIL=""
# Opcional: em ambientes internos com certificado privado, pode ser necessario false.
SMTP_REJECT_UNAUTHORIZED="true"
